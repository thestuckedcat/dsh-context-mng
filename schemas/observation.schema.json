{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.plugin/07-context-management/schemas/observation.schema.json",
  "title": "ContextObservationV1",
  "description": "Strict observation contract for the 07 context-mng read-only plugin (docs/software-design.md §4). Unknown fields are rejected. Regex is used for UUID-free formats so no external $ref or format resolver is required. The estimate is a UTF-8 byte estimate; provider-reported usage stays in reported_usage and is never apportioned into groups.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "revision",
    "boundary",
    "captured_at",
    "capture_stage",
    "fidelity",
    "request_ref",
    "provider_ref",
    "model_ref",
    "observed_digest",
    "wire_verified",
    "groups",
    "estimate",
    "reported_usage",
    "limits",
    "truncated",
    "omitted_bytes",
    "unavailable_reason"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "observation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "boundary": { "$ref": "#/$defs/boundary" },
    "captured_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "capture_stage": {
      "type": "string",
      "enum": ["session_surface", "agent_pre_step", "llm_waterfall"]
    },
    "fidelity": {
      "type": "string",
      "enum": ["history_projection", "request_observed", "unavailable"]
    },
    "request_ref": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
    "provider_ref": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
    "model_ref": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
    "observed_digest": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "wire_verified": { "const": false },
    "groups": {
      "type": "array",
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/contextGroup" }
    },
    "estimate": { "$ref": "#/$defs/estimate" },
    "reported_usage": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/reportedUsage" }]
    },
    "limits": { "$ref": "#/$defs/limits" },
    "truncated": { "type": "boolean" },
    "omitted_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "unavailable_reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 }
  },
  "$defs": {
    "scopeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_id", "generation", "identity_digest"],
      "properties": {
        "scope_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "generation": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "identity_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_ref",
        "scope",
        "last_event_seq",
        "surface_generation",
        "route_revision",
        "observation_epoch"
      ],
      "properties": {
        "session_ref": { "type": "string", "minLength": 1, "maxLength": 128 },
        "scope": { "$ref": "#/$defs/scopeRef" },
        "last_event_seq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "surface_generation": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "route_revision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "observation_epoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "contextGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "category",
        "source_ref",
        "source_kind",
        "message_refs",
        "characters",
        "bytes",
        "estimated_tokens",
        "certainty",
        "preview",
        "truncated",
        "redaction_count"
      ],
      "properties": {
        "group_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "category": {
          "type": "string",
          "enum": [
            "system",
            "developer",
            "user",
            "assistant",
            "tools",
            "tool_result",
            "memory",
            "unknown"
          ]
        },
        "source_ref": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "source_kind": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "message_refs": {
          "type": "array",
          "maxItems": 10000,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "characters": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "estimated_tokens": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "certainty": { "type": "string", "enum": ["identified", "heuristic", "unknown"] },
        "preview": { "type": "string", "maxLength": 512 },
        "truncated": { "type": "boolean" },
        "redaction_count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "tokenizer_ref", "tokens", "complete", "unpriced_modalities"],
      "description": "UTF-8 byte display estimate. tokens is null whenever an unpriced modality is present; complete is false for unpriced or truncated projections. Never a provider usage figure.",
      "properties": {
        "method": { "type": "string", "enum": ["utf8_bytes_estimate_v1", "locked_tokenizer"] },
        "tokenizer_ref": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "tokens": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "complete": { "type": "boolean" },
        "unpriced_modalities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    },
    "reportedUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_ref",
        "input_tokens",
        "output_tokens",
        "cached_input_tokens",
        "source",
        "is_final"
      ],
      "description": "Provider-reported usage, shown beside (never summed into) the group estimates.",
      "properties": {
        "request_ref": { "type": "string", "minLength": 1, "maxLength": 128 },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "source": { "const": "provider_usage_chunk" },
        "is_final": { "type": "boolean" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_window", "max_output_tokens"],
      "properties": {
        "context_window": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "max_output_tokens": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 }
      }
    }
  }
}
